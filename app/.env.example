# Gloo AI Studio
GLOO_CLIENT_ID=
GLOO_CLIENT_SECRET=
GLOO_TOKEN_URL=https://platform.ai.gloo.com/oauth2/token
GLOO_API_BASE=https://platform.ai.gloo.com/ai/v2
GLOO_MODEL=gloo-openai-gpt-4.1
GLOO_SCOPE=api/access

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Redis Cache
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_KEY_PREFIX=

# Dynamic Schema
USE_DYNAMIC_SCHEMA=false
DYNAMIC_ALLOWED_TABLES=

# App
APP_ENV=development
APP_SECRET_KEY=changeme
